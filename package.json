{
  "name": "notes-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack notes application built with React, Express and SQLite",
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"blue,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed --",
    "db:reset": "npm --prefix server run db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
